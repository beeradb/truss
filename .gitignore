# Build output
/truss
/dist/
*.test
*.out

# Go workspace files are per-developer, never shared
go.work
go.work.sum

# Editors
.idea/
.vscode/
*.swp

# The parity harness's tofu/git shim, if `go build ./...` is run from
# the repo root: it is a main package, so the binary lands here.
/fakebin

# The capture plugin is run by pytest from the platform checkout.
__pycache__/
*.pyc
# release.yml builds the per-arch binaries here before the image copies them.
dist/
