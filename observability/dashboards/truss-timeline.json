    {
      "type": "row",
      "title": "Drift",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Roots that no longer match their configuration",
      "description": "Drift is reported and never reconciled: undoing a change somebody made mid-incident is its own outage. Every band here is a change made outside the reviewed path, or a provider changing something under it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_root_drifted",
          "legendFormat": "{{root}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "perPage": 20,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
