          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "matches",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DRIFTED",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
