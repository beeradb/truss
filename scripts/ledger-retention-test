#!/usr/bin/env bash
# Proves scripts/ledger-retention still refuses what it claims to refuse.
#
# ⚠️ THIS EXISTS BECAUSE check-writes ONCE ALWAYS PASSED. It is the gate
# before `lock`, which cannot be undone, and it ended at `uniq -d` -- which
# exits 0 whether or not it printed anything. So it listed the objects that
# forbid locking and reported success while doing it. Only the lesser
# "versioning is off" case ever refused.
#
# It drives the REAL script with a fake `gcloud` on PATH, because the answers
# are what the script reads and a rewrite of its logic here would be testing
# a copy.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$HERE/ledger-retention"
[ -x "$SCRIPT" ] || { echo "ledger-retention-test: $SCRIPT is not executable" >&2; exit 1; }

pass=0 fail=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Runs check-writes against a fake gcloud answering with the given versioning
# setting and object listing. want=refuse|clean
# ⚠️ THE LISTING'S EXIT CODE IS A PARAMETER, BECAUSE THE REAL ONE HAS ONE.
# `gcloud storage ls` exits non-zero when the wildcard matches nothing, so a
# fake that always exits 0 asserts an outcome production cannot produce -- and
# when a fixture and production disagree, the fixture is the bug.
# ⚠️ AND A REFUSAL MUST NAME ITS OWN CAUSE, so `want_msg` is not optional
# decoration. Under `set -e` a command substitution that fails aborts the
# script and exits 1, which is indistinguishable from a refusal if the exit
# code is all anyone reads -- so a guard deleted outright still looked green
# here. Matching the message is what makes these cases bite.
# ⚠️ AND THE FAKE WRITES TO BOTH STREAMS, because the real one does. With
# everything on stdout the script's own `2>&1` was never exercised, and it was
# reading gcloud's chatter as object names.
#
# ⚠️ want_msg MUST BE UNIQUE TO ITS BRANCH. "cannot answer" appears in two of
# them and the unconditional header carries the words DO NOT LOCK, so those
# substrings passed under mutations that skipped the logic entirely.
check() { # name want versioning listing ls_exit want_msg [stderr]
  local name="$1" want="$2" versioning="$3" listing="$4" ls_exit="$5" want_msg="$6" said="${7:-}"
  local dir="$tmp/$RANDOM$RANDOM" out rc
  mkdir -p "$dir/bin"
  {
    echo '#!/bin/sh'
    echo 'case "$*" in'
    printf "  *describe*) printf '%%s\\\\n' '%s' ;;\n" "$versioning"
    printf "  *ls*) printf '%s'; printf '%s' >&2; exit %s ;;\n" "$listing" "$said" "$ls_exit"
    echo 'esac'
  } > "$dir/bin/gcloud"
  chmod +x "$dir/bin/gcloud"

  set +e
  out=$(PATH="$dir/bin:$PATH" TRUSS_RECORDS_BUCKET=scratch "$SCRIPT" check-writes 2>&1); rc=$?
  set -e
  local got=clean
  [ "$rc" -eq 0 ] || got=refuse
  if [ "$got" != "$want" ]; then
    fail=$((fail + 1)); echo "FAIL  $name: wanted $want, got $got" >&2
    echo "$out" | sed 's/^/      /' >&2
    return
  fi
  case "$out" in
    *"$want_msg"*) pass=$((pass + 1)); echo "ok    $name ($got)" ;;
    *) fail=$((fail + 1))
       echo "FAIL  $name: $got, but for the wrong reason -- wanted it to say \"$want_msg\"" >&2
       echo "$out" | sed 's/^/      /' >&2 ;;
  esac
}

# ⚠️ THE LOAD-BEARING CASE. Two generations of one key is precisely what
# forbids a lock: retention refuses a REPLACE as well as a delete, so a
# bucket whose objects are rewritten cannot record the failures you most
# need recorded once it is locked.
check "an object with two generations refuses" refuse True \
  'gs://<bucket>/applied/sha1#1\ngs://<bucket>/applied/sha1#2\ngs://<bucket>/HEAD#5\n' 0 "were written more than"

check "one generation each is clean" clean True \
  'gs://<bucket>/applied/sha1#1\ngs://<bucket>/applied/sha2#1\ngs://<bucket>/HEAD#5\n' 0 "none: every object"

# A rewritten HEAD is the same defect on the key that matters most.
check "a rewritten HEAD refuses" refuse True \
  'gs://<bucket>/HEAD#1\ngs://<bucket>/HEAD#2\n' 0 "were written more than"

# Versioning off means overwritten generations were discarded, so the count
# cannot answer the question -- and saying nothing would read as a pass.
check "versioning off refuses rather than printing nothing" refuse False \
  'gs://<bucket>/applied/sha1#1\n' 0 "versioning is not enabled"

# ⚠️ AN EMPTY BUCKET IS NOT A PASS, AND IT IS NOT "REWRITTEN" EITHER. The real
# gcloud exits non-zero when the wildcard matches nothing, which is the same
# silence a wrong project or an expired credential gives. Zero objects is no
# evidence that objects are written once, so it refuses -- and says which of
# the three answers it is giving.
check "an empty bucket cannot answer, and refuses" refuse True '' 1 "did not complete"

check "a failed listing refuses rather than reading as rewritten" refuse True \
  '' 1 "did not complete" \
  'ERROR: (gcloud.storage.ls) HTTPError 403: does not have storage.objects.list access\n'

# ⚠️ THE CASE THAT MAKES THE EXIT CODE LOAD-BEARING. Every other refusal is
# reachable through the empty-listing half of the guard, so with only those,
# deleting the exit-code test left the suite green. A listing that dies
# partway has already printed objects: the stdout is non-empty, it looks like
# two well-behaved keys, and it is a fragment.
check "a listing that failed partway is not a measurement" refuse True \
  'gs://<bucket>/applied/sha1#1\ngs://<bucket>/applied/sha2#1\n' 1 "did not complete" \
  'ERROR: (gcloud.storage.ls) HTTPError 500\n'

# ⚠️ THE STREAM CASES. gcloud writes notices and retry warnings to stderr on a
# perfectly successful call, and the script once merged them into the listing:
# a single notice made an EMPTY bucket look measured and clean, and a warning
# printed twice came back from `uniq -d` as a rewritten object.
check "a notice on stderr is not an object" refuse True '' 0 "Updates are available" \
  'Updates are available for some Google Cloud CLI components.\n'

check "a warning repeated on stderr is not a rewrite" clean True \
  'gs://<bucket>/applied/sha1#1\ngs://<bucket>/HEAD#5\n' 0 "none: every object" \
  'WARNING: retrying request\nWARNING: retrying request\n'

echo
echo "ledger-retention-test: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
