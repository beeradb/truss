#!/usr/bin/env bash
# Proves scripts/leakscan still refuses what it claims to refuse.
#
# ⚠️ THIS EXISTS BECAUSE THE SCANNER WAS ONCE VACUOUS AND SAID IT WAS CLEAN.
# Two patterns were written with an inline `(?i)`, which GNU grep rejects as
# `warning: ? at start of expression` and matches nothing with -- so the
# credential-shaped scan and the concrete-store scan never ran, in CI, while
# reporting success. Every guard here has been watched failing.
#
# It drives the REAL scanner against a real throwaway git repository, because
# leakscan reads `git ls-files` and a fixture that skipped git would be
# testing something else.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
SCAN="$HERE/leakscan"
[ -x "$SCAN" ] || { echo "leakscan-test: $SCAN is not executable" >&2; exit 1; }

pass=0 fail=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Runs the scanner over a repo containing exactly the given file content.
# want=refuse|clean
check() { # name want filename content
  local name="$1" want="$2" file="$3" content="$4"
  local dir="$tmp/$RANDOM$RANDOM" out rc
  mkdir -p "$dir/scripts" "$dir/$(dirname "$file")"
  cp "$SCAN" "$dir/scripts/leakscan"
  printf '%s\n' "$content" > "$dir/$file"
  git -C "$dir" init -q -b main
  git -C "$dir" add -A
  set +e
  out="$(cd "$dir" && ./scripts/leakscan 2>&1)"; rc=$?
  set -e
  local got=clean
  [ "$rc" -eq 0 ] || got=refuse
  if [ "$got" = "$want" ]; then
    pass=$((pass + 1)); echo "ok    $name ($got)"
  else
    fail=$((fail + 1)); echo "FAIL  $name: wanted $want, got $got" >&2
    echo "$out" | sed 's/^/      /' >&2
  fi
}

# ⚠️ `check` stages but never COMMITS, so `git log` is empty in its fixture and
# it cannot express a commit-message case at all. That is why the trailer guard
# had no test, and why it stayed vacuous under pipefail for its whole life. A
# fixture that cannot ask a question is indistinguishable from one whose answer
# is always "clean".
#
# ⚠️ AND THE FIXTURE MUST BE DEEP, WHICH A ONE-COMMIT ONE IS NOT. The bug was
# SIGPIPE: `grep -q` exits at its first match, `git log` dies writing the rest,
# and pipefail hands the `if` that failure. With a single small commit git log
# finishes writing before grep exits, nothing gets a signal, and the broken
# guard PASSES -- verified, by reverting the fix and watching this file stay
# green. `deep` puts bulk BEHIND the match: the trailer is newest so grep quits
# immediately, and git log still has ~200 KB of older history to write.
check_msg() { # name want message [deep]
  local name="$1" want="$2" message="$3" deep="${4:-}"
  local dir="$tmp/$RANDOM$RANDOM" out rc
  mkdir -p "$dir/scripts"
  cp "$SCAN" "$dir/scripts/leakscan"
  printf 'placeholder\n' > "$dir/file.txt"
  git -C "$dir" init -q -b main
  git -C "$dir" add -A
  if [ -n "$deep" ]; then
    # Via a file, not argv: 200 KB of -m is "Argument list too long".
    { printf 'older history\n\n'; head -c 200000 /dev/zero | tr '\0' 'x'; } \
      > "$dir/.bulkmsg"
    git -C "$dir" -c user.name=t -c user.email=t@t commit -q -F "$dir/.bulkmsg"
    rm -f "$dir/.bulkmsg"
  fi
  git -C "$dir" -c user.name=t -c user.email=t@t commit -q --allow-empty -m "$message"

  # grandfather=self  excuse the commit just made, by its real SHA
  # grandfather=stale excuse a SHA that is not in this repository at all
  case "${5:-}" in
    self)  git -C "$dir" rev-parse HEAD > "$dir/scripts/leakscan-grandfathered" ;;
    stale) printf '%040d\n' 0 > "$dir/scripts/leakscan-grandfathered" ;;
  esac

  set +e
  out="$(cd "$dir" && ./scripts/leakscan 2>&1)"; rc=$?
  set -e
  local got=clean
  [ "$rc" -eq 0 ] || got=refuse
  if [ "$got" = "$want" ]; then
    pass=$((pass + 1)); echo "ok    $name ($got)"
  else
    fail=$((fail + 1)); echo "FAIL  $name: wanted $want, got $got" >&2
    echo "$out" | sed 's/^/      /' >&2
  fi
}

# One per class the scanner claims to catch. If any of these starts passing
# as clean, that scan has stopped working -- which is exactly what happened.
check 'email address'      refuse notes.md   'ask someone@example.org about it'
check 'IP address'         refuse notes.md   'the box answers on 203.0.113.7 only'
check 'long hex string'    refuse notes.md   'account 0123456789abcdef0123456789abcdef'
check 'uppercase hex'      refuse notes.md   'account 0123456789ABCDEF0123456789ABCDEF'
check 'credential shape'   refuse conf.yaml  'api_key: sk-abcdefghijklmnopqrstuv'
check 'credential, capsed' refuse conf.yaml  'API_KEY = ABCDEFGHIJKLMNOPQRSTUV'
check 'concrete store'     refuse conf.yaml  'reads op://platform/thing/field'
check 'store, capsed'      refuse conf.yaml  'reads OP://PLATFORM/thing/field'
check 'bucket url'         refuse conf.yaml  'state lives in gs://someones-real-bucket'
check 'url into a host'    refuse notes.md   'see example.com/private/thing for it'

# The other direction. A scanner that refuses everything is no more useful
# than one that refuses nothing, and the go.mod exemption is narrow on purpose.
check 'ordinary prose'     clean  notes.md   'The applier refuses a plan it did not make.'
check 'go.mod module line' clean  go.mod     'module github.com/beeradb/truss'
check 'go.mod, other line' refuse go.mod     'module github.com/beeradb/truss
// see example.com/private/thing'

# A pinned action is a commit id of somebody else's public repository. CI
# caught this on the scanner's first green run; the exemption is the `uses:`
# line shape, so a bare hex string anywhere else in the same file still bites.
check 'pinned action'      clean  .github/workflows/ci.yml '      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1'
check 'hex in a workflow'  refuse .github/workflows/ci.yml '      - run: echo 0123456789abcdef0123456789abcdef'
check 'unpinned uses line' clean  .github/workflows/ci.yml '      - uses: actions/checkout@v7'

# ⚠️ THE VENDOR'S NAME IS NOT A LEAK; A REFERENCE INTO THEIR STORE IS. A design
# document has to be able to name the product it integrates with. What must
# still bite is anything that says WHICH vault, WHICH bucket, WHICH account.
check 'vendor name in prose' clean  docs/d.md 'The applier reads 1Password items at build time.'
check 'op:// reference'      refuse docs/d.md 'reads op://somevault/someitem/field'
check 'module path in prose' clean  docs/d.md 'the module is github.com/beeradb/truss'
check 'someone elses repo'   refuse docs/d.md 'clone github.com/otherorg/private-thing now'
check 'a bucket uri'         refuse docs/d.md 'state lives in gs://a-real-bucket-name'

# ⚠️ The SVG namespace is a constant every SVG carries; a real URL in an SVG is
# not. Exempting the exact declaration keeps the second case biting.
check 'svg namespace'        clean  m.svg '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"></svg>'
check 'real url in an svg'   refuse m.svg '<image xlink:href="https://assets.example.com/logo/mark.png"/>'

# ⚠️ A vendor's documented API root is the same for everybody; a URL carrying
# our bucket name is not. The second case is the one that must keep biting.
check 'telegram api root'    clean  n.go 'const ep = "https://api.telegram.org/bot%s/sendMessage"'
check 'github api root'      clean  n.go 'const ep = "https://api.github.com/repos/%s/pulls"'
check 'our bucket in a url'  refuse n.go 'const u = "https://storage.googleapis.com/some-real-tfstate/key"'

# ⚠️ THE govulncheck EXEMPTION, AND THE PAIR THAT KEEPS IT NARROW. AGENTS.md
# requires a passing AND a refusing case for every exemption, and here the
# refusing one carries most of the weight: the exempted string is ONE module
# path, not the golang.org/x namespace, so a DIFFERENT golang.org/x path must
# still bite. Widen the pattern to `golang\.org/x/` and this goes green, which
# is how the widening gets caught.
#
# That guards more than leaks. This repository has no dependencies -- go.mod is
# three lines and there is no go.sum (port-plan.md §7.1) -- so a golang.org/x
# path in a tracked file is a dependency being added or a doc claiming one, and
# leakscan refusing it is the guard on that rule too.
# ⚠️ A STORE URI NAMED BY A VARIABLE OR A PLACEHOLDER, AND THE CONCRETE ONE
# THAT MUST STILL BITE. scripts/ledger-retention reads its bucket from the
# environment so this repository never writes one down; the refusing case is
# what keeps that exemption from becoming "gs:// is fine".
check 'bucket from a variable'   clean  d.sh 'gcloud storage buckets describe "gs://$BUCKET"'
check 'bucket as a placeholder'  clean  d.sh 'gcloud storage buckets create gs://<scratch>'
check 'a real bucket still bites' refuse d.sh 'gcloud storage buckets describe gs://some-real-tfstate'

check 'govulncheck is exempt'  clean  d.go 'go run golang.org/x/vuln/cmd/govulncheck@v1.8.0 ./...'
check 'other x/ still bites'   refuse d.go 'import "golang.org/x/mod/sumdb/note"'

# ⚠️ THE UPSTREAM DOWNLOAD EXEMPTIONS, AND THE PAIR THAT KEEPS THEM HONEST.
# The image fetches the two binaries it runs, so their release URLs must pass.
# The refusing cases are the point: `github.com/<owner>/<repo>` is exactly the
# shape that names OUR infrastructure, so exempting github.com generally would
# have let the platform repository's own URL through. Pinned to the project
# path instead, and this is what proves it.
check 'opentofu release'     clean  d.txt 'curl -o t.zip https://github.com/opentofu/opentofu/releases/download/v1.12.6/tofu_1.12.6_linux_amd64.zip'
check 'another repo on gh'   refuse d.txt 'see https://github.com/someone/private-infra/blob/main/apply.sh'
check '1password packages'   clean  d.txt 'curl https://downloads.1password.com/linux/keys/1password.asc'
check '1password vault uri'  refuse d.txt 'op://platform/gcs-ledger/endpoint'

# ⚠️ The trailer guard reads history, not the tree, so these are the only cases
# here that need a real commit. The clean case matters as much as the refusing
# one: a guard that refuses every message is as useless as one that refuses
# none, and only the pair proves it is reading what it claims to read.
check_msg 'ordinary commit message' clean \
  'Fix the thing

Because it was broken.'
check_msg 'ai co-author trailer'    refuse \
  'Fix the thing

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>'
check_msg 'ai co-author, odd case'  refuse \
  'Fix the thing

co-authored-by: SOME ANTHROPIC MODEL <x@y>'

# ⚠️ THIS IS THE CASE THAT ACTUALLY GUARDS THE GUARD. The three above stay
# green against the broken `grep -q` version; only this one goes red, because
# only this one gives git log enough to write that closing the pipe early
# raises SIGPIPE. Revert the fix in leakscan and this must fail.
check_msg 'ai co-author, deep history' refuse \
  'Fix the thing

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>' deep

# ⚠️ The grandfather list is the only way past the trailer guard, so it needs
# testing in both directions and in the direction nobody thinks of: an
# exemption that has stopped excusing anything. Left alone, a stale line sits
# there permanently widening the guard for a commit that no longer exists.
check_msg 'trailer, grandfathered'   clean  \
  'Fix the thing

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>' '' self
check_msg 'stale grandfather entry'  refuse \
  'Fix the thing

no trailer here' '' stale

echo
echo "leakscan-test: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
