#!/usr/bin/env bash
# Refuses to let anything identifying the author's own deployment reach this
# repository.
#
# ⚠️ THIS REPOSITORY IS WRITTEN TO BE PUBLIC, AND IS PORTED FROM A PRIVATE
# ONE. That is the whole risk: the reference implementation is a live
# platform with real account ids, bucket names, hostnames and vault names in
# it, and porting is a copying exercise. A grep is cheap; noticing an account
# id in a commit six months later is not.
#
# It scans for CLASSES of thing, not a list of the author's secrets -- a
# denylist of real values would itself be the leak.
set -euo pipefail

fail=0
note() { echo "leakscan: $*" >&2; fail=1; }

# Files git actually tracks; build output and vendored code are not ours.
files=$(git ls-files | grep -vE '^(vendor/|go\.sum$)' || true)
[ -n "$files" ] || exit 0

# ⚠️ -i ON EVERY SCAN, AND NEVER AN INLINE `(?i)`. Two of the patterns
# below were written `(?i)...`, which is not valid ERE: GNU grep answers
# `warning: ? at start of expression` and matches NOTHING, so the two most
# valuable scans -- the credential-shaped one and the concrete-store one --
# passed vacuously. It looked fine locally only because this author's `grep`
# was ugrep, which accepts the inline form. A guard that cannot fail is worse
# than no guard, because it reports success. scripts/leakscan-test is the
# answer to that and runs in CI beside this.
#
# Case-insensitive for ALL of them rather than per-pattern: one rule, nothing
# to get wrong at a call site. It widens the hex scan to uppercase, which is
# correct -- an account id in capitals is still an account id.
scan() { # pattern description
  local hits
  hits=$(grep -nEIi "$1" $files 2>/dev/null | grep -v 'leakscan' || true)
  # Two exemptions, both for public identifiers that this repository is
  # REQUIRED to state, and both written as the exact line shape rather than as
  # a filename -- exempting a whole file would hide a real leak added to it.
  #
  #   go.mod's module path: the author's public handle, where Go demands it.
  #   a workflow's `uses: owner/action@<sha>`: pinning an action to a commit
  #   is the supply-chain-correct thing to do, and a commit id of somebody
  #   else's public repository identifies nothing of ours. Caught in CI on
  #   this scanner's own first green run, which is the argument for pinning
  #   the exemption to the `uses:` shape and not to `.github/`.
  hits=$(echo "$hits" | grep -vE '^go\.mod:[0-9]+:module ' || true)
  # ⚠️ AND THE MODULE PATH WHEREVER IT IS WRITTEN, not only in go.mod. Docs and
  # code have to name the import path, and it is this repository's own name --
  # the same public handle already exempted above, in the same words.
  hits=$(echo "$hits" | grep -vE 'github\.com/beeradb/truss' || true)
  # ⚠️ THE SVG NAMESPACE, WHICH IS A CONSTANT AND NOT A DESTINATION. Every SVG
  # file must declare `xmlns="http://www.w3.org/2000/svg"` -- it is an XML
  # namespace identifier, never fetched, and identical in every SVG ever
  # written. Exempted as the exact string, so a real URL in an SVG (an
  # xlink:href to an asset host, say) is still caught.
  hits=$(echo "$hits" | grep -vF 'xmlns="http://www.w3.org/2000/svg"' || true)
  # ⚠️ PUBLIC VENDOR API ENDPOINTS, LISTED EXACTLY. A URL path into a host is
  # refused because it usually names OUR deployment -- a bucket, a hostname we
  # own, an account. A vendor's documented API root names the vendor and is
  # identical for every user of it: api.telegram.org/bot<token>/sendMessage is
  # the only address Telegram has.
  #
  # Listed host by host rather than matched by shape, so the exemption is
  # auditable and cannot widen by accident. Note what is NOT here:
  # storage.googleapis.com, because the path after it carries a bucket name
  # and that IS this deployment.
  hits=$(echo "$hits" | grep -vE 'https://api\.(telegram\.org|github\.com)/' || true)
  hits=$(echo "$hits" | grep -vE '^\.github/workflows/[^:]+:[0-9]+:[[:space:]]*-?[[:space:]]*uses:[[:space:]]*[A-Za-z0-9._/-]+@[0-9a-f]{40}([[:space:]]|#|$)' || true)
  [ -z "$hits" ] || { note "$2"; echo "$hits" | head -5 >&2; }
}

scan '[0-9a-zA-Z._%+-]+@[0-9a-zA-Z.-]+\.[a-zA-Z]{2,}' \
     'an email address (use a noreply address, or nothing)'
scan '\b(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(\.(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}\b' \
     'an IP address'
scan '\b[0-9a-f]{32,}\b' \
     'a 32+ character hex string (account id, key id, hash of something real)'
scan '(secret|token|password|api[_-]?key|credential)[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+_-]{16,}' \
     'something shaped like an assigned credential'
scan '\b[A-Za-z0-9-]+\.(com|net|org|io|dev|pw)\b/[A-Za-z0-9._/-]+' \
     'a URL path into a specific host'
# ⚠️ A URI INTO A STORE, NOT THE VENDOR'S NAME. `1password` alone was in this
# list and it is not a deployment identifier -- it is a company, and a design
# document that integrates with them has to be able to say so. What identifies
# a deployment is a reference INTO a store: `op://<vault>/<item>`, a bucket
# URI, an account id. Those stay. Measured 2026-09-08: the bare vendor name
# refused docs/port-plan.md for naming the product it ports away from.
scan '\b(op://|cloudflare account|gs://|s3://)' \
     'a reference to a concrete store or account'

# ⚠️ Co-authored-by trailers are refused here as well as by the commit hook,
# because a hook lives on one machine and this runs for everybody.
#
# ⚠️ COUNTED, NOT `grep -q`, AND THAT IS THE WHOLE POINT. Under `pipefail`
# this guard was VACUOUS for its entire life: `grep -q` exits on its first
# match and closes the pipe, `git log` dies of SIGPIPE with 141, and pipefail
# hands the `if` that 141 -- so the condition read FALSE precisely when there
# was something to find. Seven trailers sat in this history while it printed
# "clean". `grep -c` reads its input to the end, so nothing gets a SIGPIPE
# and the count is the answer.
trailers=$(git log --format='%b' 2>/dev/null |
  grep -ciE '^[[:space:]]*co-authored-by:.*(claude|anthropic)' || true)
if [ "${trailers:-0}" -gt 0 ]; then
  note "$trailers Co-Authored-By trailer(s) naming an AI assistant"
fi

[ "$fail" -eq 0 ] || { echo "leakscan: refusing" >&2; exit 1; }
echo "leakscan: clean"
